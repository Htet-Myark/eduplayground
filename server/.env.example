# Server port
PORT=5000

# PostgreSQL connection string (optional — app falls back to in-memory store without it)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Google Gemini API — get a key from https://aistudio.google.com/apikey
# Free-tier availability and limits depend on model, account, and region.
GEMINI_API_KEY=
# Optional model override. The default is gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
